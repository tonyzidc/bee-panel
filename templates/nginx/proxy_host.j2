# Bee Panel v2 - Proxy Host Configuration
# Domain: {{ domain_names | join(", ") }}
# Managed by Bee Panel (Do not edit directly)

{% if access_list_id %}
# Access List: {{ access_list_id }}
include /etc/nginx/bee-panel/access/{{ access_list_id }}.conf;
{% endif %}

server {
    listen 80;
    listen [::]:80;
    server_name {{ domain_names | join(" ") }};

    # ACME Challenge endpoint for Let's Encrypt / ZeroSSL
    location ^~ /.well-known/acme-challenge/ {
        default_type "text/plain";
        root /var/lib/bee-panel/acme-challenges;
        try_files $uri =404;
    }

{% if ssl_certificate_id and ssl_forced %}
    # Redirect all HTTP traffic to HTTPS
    location / {
        return 301 https://$host$request_uri;
    }
}
{% else %}
    # Main HTTP Reverse Proxy Configuration
    location / {
{% if block_exploits %}
        # Block common exploit patterns
        if ($query_string ~* "(<|%3C).*script.*(>|%3E)") { return 403; }
        if ($query_string ~* "base64_(en|de)code[^(]*\(") { return 403; }
        if ($query_string ~* "(GLOBALS|\[(?:_|GLOBALS))") { return 403; }
        if ($query_string ~* "(\+|%2B)(concat|delete|select|insert|union|into)") { return 403; }
{% endif %}

        proxy_pass {{ forward_scheme }}://{{ forward_host }}:{{ forward_port }};
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header X-Forwarded-Port $server_port;

{% if websocket_support %}
        # WebSocket Upgrade support
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
{% endif %}

{% if caching_enabled %}
        # Asset Caching
        proxy_cache_valid 200 302 10m;
        proxy_cache_valid 404      1m;
{% endif %}
    }

{% for loc in custom_locations %}
    location {{ loc.path }} {
        proxy_pass {{ loc.forward_scheme }}://{{ loc.forward_host }}:{{ loc.forward_port }};
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
{% if loc.advanced_config %}
        {{ loc.advanced_config }}
{% endif %}
    }
{% endfor %}

{% if advanced_config %}
    # Custom Advanced Directives
    {{ advanced_config }}
{% endif %}
}
{% endif %}

{% if ssl_certificate_id %}
server {
    listen 443 ssl{% if http2_support %} http2{% endif %};
    listen [::]:443 ssl{% if http2_support %} http2{% endif %};
    server_name {{ domain_names | join(" ") }};

    ssl_certificate {{ ssl_cert_path }};
    ssl_certificate_key {{ ssl_key_path }};
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_prefer_server_ciphers off;

{% if hsts_enabled %}
    # HSTS Policy
    add_header Strict-Transport-Security "max-age=31536000{% if hsts_subdomains %}; includeSubDomains{% endif %}" always;
{% endif %}

    # ACME Challenge endpoint
    location ^~ /.well-known/acme-challenge/ {
        default_type "text/plain";
        root /var/lib/bee-panel/acme-challenges;
        try_files $uri =404;
    }

    location / {
{% if block_exploits %}
        # Block common exploit patterns
        if ($query_string ~* "(<|%3C).*script.*(>|%3E)") { return 403; }
        if ($query_string ~* "base64_(en|de)code[^(]*\(") { return 403; }
        if ($query_string ~* "(GLOBALS|\[(?:_|GLOBALS))") { return 403; }
        if ($query_string ~* "(\+|%2B)(concat|delete|select|insert|union|into)") { return 403; }
{% endif %}

        proxy_pass {{ forward_scheme }}://{{ forward_host }}:{{ forward_port }};
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header X-Forwarded-Port $server_port;

{% if websocket_support %}
        # WebSocket Upgrade support
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
{% endif %}

{% if caching_enabled %}
        # Asset Caching
        proxy_cache_valid 200 302 10m;
        proxy_cache_valid 404      1m;
{% endif %}
    }

{% for loc in custom_locations %}
    location {{ loc.path }} {
        proxy_pass {{ loc.forward_scheme }}://{{ loc.forward_host }}:{{ loc.forward_port }};
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
{% if loc.advanced_config %}
        {{ loc.advanced_config }}
{% endif %}
    }
{% endfor %}

{% if advanced_config %}
    # Custom Advanced Directives
    {{ advanced_config }}
{% endif %}
}
{% endif %}
